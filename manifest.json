{
    "manifest_version": 3,
    "name": "TakeVid",
    "description": "Save Youtube, TikTok, Facebook and Instagram videos in high quality or MP3",
    "version": "1.1.0",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "options_page": "options.html",
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "downloads",
        "cookies",
        "storage",
        "contextMenus",
        "notifications"
    ],
    "host_permissions": [
        "https://takevid-server.onrender.com/*",
        "*://*.youtube.com/*",
        "*://*.youtu.be/*",
        "*://*.tiktok.com/*",
        "*://*.facebook.com/*",
        "*://*.fb.watch/*",
        "*://*.instagram.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*",
                "*://*.youtu.be/*",
                "*://*.tiktok.com/*",
                "*://*.facebook.com/*",
                "*://*.fb.watch/*",
                "*://*.instagram.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle",
            "all_frames": false
        }
    ],
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Ctrl+Shift+Y",
                "mac": "Command+Shift+Y"
            },
            "description": "Open TakeVid popup"
        },
        "download-current": {
            "suggested_key": {
                "default": "Ctrl+Shift+D",
                "mac": "Command+Shift+D"
            },
            "description": "Download current video"
        }
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    }
}